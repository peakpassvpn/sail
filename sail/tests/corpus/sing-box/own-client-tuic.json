      "heartbeat": "10s",
      "tls": {
        "enabled": true,
        "server_name": "server.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "tuic"
  }
}
