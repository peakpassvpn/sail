{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tcp",
        "tag": "dns-1",
        "detour": "Group 1",
        "domain_resolver": "dns-2",
        "server": "192.0.2.1"
      },
      {
        "type": "tcp",
        "tag": "dns-2",
        "detour": "Proxy 1",
        "server": "192.0.2.2"
      },
      {
        "type": "local",
        "tag": "dns-3",
        "detour": "Proxy 1"
      }
    ],
    "rules": [
      {
        "rule_set": "set-3",
        "server": "dns-3"
      },
      {
        "clash_mode": "Direct",
        "server": "dns-3"
      },
      {
        "source_ip_cidr": [
          "192.0.2.1/30",
          "fdfe:dcba:9876::1/126"
        ],
        "server": "dns-1"
      },
      {
        "clash_mode": "Global",
        "server": "dns-1"
      }
    ],
    "final": "dns-1",
    "strategy": "prefer_ipv4",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "in-1",
      "mtu": 9000,
      "address": [
        "192.0.2.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "stack": "system",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "type": "mixed",
      "tag": "in-2",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Group 1",
      "outbounds": [
        "Group 2",
        "Proxy 1",
        "Proxy 2"
      ],
      "default": "Proxy 2"
    },
    {
      "type": "urltest",
      "tag": "Group 2",
      "outbounds": [
        "Proxy 2"
      ],
      "url": "http://h1.example.com/generate_204",
      "interval": "10m0s",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "Proxy 1",
      "domain_strategy": "prefer_ipv4"
    },
    {
      "type": "hysteria2",
      "tag": "Proxy 2",
      "server": "s1.example.net",
      "server_port": 8443,
      "obfs": {
        "type": "salamander",
        "password": "password1"
      },
      "password": "password1",
      "tls": {
        "enabled": true,
        "insecure": true
      }
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Proxy 1"
      },
      {
        "clash_mode": "Global",
        "outbound": "Group 1"
      },
      {
        "rule_set": [
          "set-4",
          "set-2",
          "set-3",
          "set-5"
        ],
        "outbound": "Proxy 1"
      },
      {
        "rule_set": "set-1",
        "outbound": "Proxy 3"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "set-1",
        "format": "binary",
        "url": "https://h2.example.com/p1.srs",
        "download_detour": "Proxy 1"
      },
      {
        "type": "remote",
        "tag": "set-2",
        "format": "binary",
        "url": "https://h2.example.com/p2.srs",
        "download_detour": "Proxy 1"
      },
      {
        "type": "remote",
        "tag": "set-3",
        "format": "binary",
        "url": "https://h2.example.com/p3.srs",
        "download_detour": "Proxy 1"
      },
      {
        "type": "remote",
        "tag": "set-4",
        "format": "binary",
        "url": "https://h2.example.com/p4.srs",
        "download_detour": "Proxy 1"
      },
      {
        "type": "remote",
        "tag": "set-5",
        "format": "binary",
        "url": "https://h2.example.com/p5.srs",
        "download_detour": "Proxy 1"
      }
    ],
    "final": "Group 1",
    "auto_detect_interface": true,
    "override_android_vpn": true,
    "default_domain_resolver": "dns-3"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
