{
  "$schema": "https://h3.example.com/p13.json",
  "certificate": {
    "store": "mozilla"
  },
  "dns": {
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-3"
      }
    ],
    "servers": [
      {
        "detour": "Group 1",
        "server": "192.0.2.1",
        "tag": "dns-1",
        "type": "https"
      },
      {
        "tag": "dns-2",
        "type": "local"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "3f00::/18",
        "tag": "dns-3",
        "type": "fakeip"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "http_clients": [
    {
      "tag": "str1"
    }
  ],
  "inbounds": [
    {
      "address": [
        "192.0.2.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "exclude_package": [
        "com.example.app1",
        "com.example.app2",
        "com.example.app3",
        "com.example.app4",
        "com.example.app5",
        "com.example.app6",
        "com.example.app7"
      ],
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      },
      "stack": "gvisor",
      "strict_route": true,
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "Group 2",
        "Group 3",
        "Proxy 1"
      ],
      "tag": "Group 1",
      "type": "selector"
    },
    {
      "outbounds": [
        "Proxy 2",
        "Proxy 3"
      ],
      "tag": "Group 2",
      "type": "urltest",
      "url": "https://h1.example.com/generate_204"
    },
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "Proxy 2",
        "Proxy 3"
      ],
      "tag": "Group 3",
      "type": "selector"
    },
    {
      "domain_resolver": "dns-2",
      "tag": "Proxy 1",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 1819,
      "tag": "Proxy 2",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 9050,
      "tag": "Proxy 3",
      "type": "socks"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-2",
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "url": "https://h2.example.com/p1.srs"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "url": "https://h2.example.com/p2.srs"
      },
      {
        "tag": "set-3",
        "type": "remote",
        "url": "https://h2.example.com/p3.srs"
      },
      {
        "tag": "set-4",
        "type": "remote",
        "url": "https://h2.example.com/p4.srs"
      },
      {
        "tag": "set-5",
        "type": "remote",
        "url": "https://h2.example.com/p5.srs"
      },
      {
        "tag": "set-6",
        "type": "remote",
        "url": "https://h2.example.com/p6.srs"
      },
      {
        "tag": "set-7",
        "type": "remote",
        "url": "https://h2.example.com/p7.srs"
      },
      {
        "tag": "set-8",
        "type": "remote",
        "url": "https://h2.example.com/p8.srs"
      },
      {
        "tag": "set-9",
        "type": "remote",
        "url": "https://h2.example.com/p9.srs"
      },
      {
        "tag": "set-10",
        "type": "remote",
        "url": "https://h2.example.com/p10.srs"
      },
      {
        "tag": "set-11",
        "type": "remote",
        "url": "https://h2.example.com/p11.srs"
      },
      {
        "tag": "set-12",
        "type": "remote",
        "url": "https://h2.example.com/p12.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "Proxy 1"
      },
      {
        "outbound": "Proxy 1",
        "process_name": [
          "app1",
          "app2.exe",
          "app3",
          "app4.exe",
          "app5",
          "app6.exe",
          "app7",
          "app8.exe"
        ]
      },
      {
        "outbound": "Proxy 1",
        "protocol": [
          "bittorrent",
          "ntp"
        ]
      },
      {
        "action": "reject",
        "rule_set": [
          "set-1",
          "set-2",
          "set-3",
          "set-4",
          "set-5",
          "set-6",
          "set-7",
          "set-8"
        ]
      },
      {
        "outbound": "Proxy 1",
        "rule_set": [
          "set-9",
          "set-10",
          "set-11",
          "set-12"
        ]
      }
    ]
  },
  "services": [
    {
      "dashboard": true,
      "listen_port": 9090,
      "type": "api"
    }
  ]
}
