{
  "log": {
    "disabled": false,
    "level": "panic",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "type": "tls",
        "server": "192.0.2.1"
      },
      {
        "tag": "dns-2",
        "address": "fakeip"
      }
    ],
    "rules": [
      {
        "query_type": [
          "SVCB"
        ],
        "server": "dns-3"
      },
      {
        "inbound": "in-1",
        "server": "dns-2",
        "disable_cache": false,
        "rewrite_ttl": 1
      },
      {
        "outbound": "any",
        "server": "dns-1",
        "disable_cache": true
      }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "28.0.0.1/8",
      "inet6_range": "3f00::/18"
    },
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "listen": "::",
      "listen_port": 10000
    },
    {
      "type": "direct",
      "tag": "in-1",
      "listen": "::",
      "listen_port": 6666
    },
    {
      "type": "redirect",
      "tag": "in-2",
      "listen": "::",
      "sniff_override_destination": true,
      "listen_port": 7877,
      "sniff": true
    },
    {
      "type": "tproxy",
      "tag": "in-3",
      "listen": "::",
      "listen_port": 7896,
      "tcp_fast_open": true,
      "sniff": true,
      "sniff_override_destination": false,
      "sniff_timeout": "100ms"
    }
  ],
  "outbounds": [
    {
      "tag": "Group 1",
      "type": "selector",
      "outbounds": [
        "Proxy 2"
      ]
    },
    {
      "type": "direct",
      "tag": "Proxy 1"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "in-4",
        "action": "hijack-dns"
      },
      {
        "network": "udp",
        "port": 443,
        "action": "reject",
        "method": "drop"
      },
      {
        "ip_is_private": true,
        "outbound": "Proxy 1"
      },
