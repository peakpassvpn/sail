        "Group 4",
        "Group 5",
        "Group 6",
        "Group 7",
        "GLOBAL"
      ]
    },
    {
      "tag": "Group 4",
      "type": "urltest",
      "outbounds": [
        "Proxy 2"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "str2"
          ]
        }
      ]
    },
    {
      "tag": "Group 5",
      "type": "urltest",
      "outbounds": [
        "Proxy 2"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "str3"
          ]
        }
      ]
    },
    {
      "tag": "Group 6",
      "type": "urltest",
      "outbounds": [
        "Proxy 2"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "str4"
          ]
        },
        {
          "action": "exclude",
          "keywords": [
            "str5"
          ]
        }
