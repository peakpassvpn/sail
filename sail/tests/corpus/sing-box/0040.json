  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "tag": "Group 1",
      "type": "selector",
      "outbounds": [
        "Group 4",
        "Group 5",
        "Group 6",
        "Group 7",
        "GLOBAL"
      ]
    },
    {
      "tag": "Group 2",
