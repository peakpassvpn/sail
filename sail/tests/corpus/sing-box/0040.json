    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "path": "./path-2.db",
      "cache_id": "password1"
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "./path-3",
      "external_ui_download_url": "https://h1.example.com/p11.zip",
      "external_ui_download_detour": "Group 1",
      "default_mode": "rule"
    }
  },
  "ntp": {
    "enabled": true,
    "server": "s28.example.net",
    "server_port": 123,
    "interval": "30m"
  },
