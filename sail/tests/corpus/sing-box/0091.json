{
  "log": {
    "disabled": false,
    "level": "info",
    "output": "str1",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "address": "192.0.2.1"
      },
      {
        "tag": "dns-2",
        "address": "https://192.0.2.2/dns-query"
      }
    ],
    "rules": [
      {
        "inbound": [
          "in-1"
        ],
        "ip_version": 4,
        "network": "tcp",
        "auth_user": [
          "user1"
        ],
        "protocol": [
          "tls",
          "http",
          "quic"
        ],
        "server": "dns-1"
      }
    ],
    "final": "dns-2",
    "strategy": "",
    "disable_cache": false,
    "disable_expire": false,
    "independent_cache": false,
    "reverse_mapping": false,
    "fakeip": {}
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "user2",
          "password": "password1"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "::",
        "key_path": "password2",
        "certificate_path": "password3"
      },
      "masquerade": "http://127.0.0.1:80"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Proxy 1"
    },
    {
      "type": "block",
      "tag": "Proxy 2"
    }
  ],
  "route": {
    "rules": [
      {
        "rule_set": "set-1",
        "outbound": "Proxy 2"
      }
    ],
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p1.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p2.srs",
        "download_detour": "Proxy 1"
      }
    ],
    "auto_detect_interface": true,
    "final": "Proxy 1"
  },
  "experimental": {}
}
