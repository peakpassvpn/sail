    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-1",
        "server": "192.0.2.1",
        "domain_resolver": "dns-2"
      },
      {
        "type": "udp",
        "tag": "dns-2",
        "server": "192.0.2.1"
      },
      {
        "type": "https",
        "tag": "dns-3",
        "server": "192.0.2.2",
        "detour": "Group 1"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA",
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "dns-1"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "dns-3"
      },
      {
        "rule_set": "set-4",
