    {
      "type": "direct",
      "tag": "Proxy 1"
    },
    {
      "type": "block",
      "tag": "Proxy 2"
    },
    {
      "type": "selector",
      "tag": "PROXY",
      "outbounds": [
        "Group 2",
        "Proxy 1",
        "Proxy 2",
        "Proxy 3",
        "Proxy 4",
        "Proxy 5",
        "Proxy 6",
        "Proxy 7",
        "Proxy 8",
        "Proxy 9",
        "Proxy 10",
        "Proxy 11",
        "Proxy 12",
        "Proxy 13"
      ],
      "default": "Group 2"
    },
    {
      "type": "selector",
      "tag": "Group 1",
      "outbounds": [
        "Proxy 3",
        "Proxy 4",
        "Proxy 5",
        "Proxy 6",
        "Proxy 7",
        "Proxy 8",
        "Proxy 9",
        "Proxy 10",
        "Proxy 11",
        "Proxy 12",
        "Proxy 13"
      ]
    },
