{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "udp",
        "server": "192.0.2.53"
      },
      {
        "type": "tcp",
        "tag": "tcp",
        "server": "192.0.2.53",
        "server_port": 53
      },
      {
        "type": "tls",
        "tag": "tls",
        "server": "dns.example.com",
        "tls": {
          "enabled": true,
          "server_name": "dns.example.com"
        },
        "domain_resolver": "local"
      },
      {
        "type": "https",
        "tag": "https",
        "server": "dns.example.com",
        "path": "/dns-query",
        "domain_resolver": "local",
        "detour": "proxy"
      },
      {
        "type": "quic",
        "tag": "quic",
        "server": "dns.example.com",
        "domain_resolver": "local"
      },
      {
        "type": "h3",
        "tag": "h3",
        "server": "dns.example.com",
        "domain_resolver": "local"
      },
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "router.lan": [
            "192.168.1.1"
          ]
        }
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "lan"
        ],
        "server": "hosts"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "domain_suffix": [
          "proxied.example"
        ],
        "server": "fakeip"
      },
      {
        "domain_suffix": [
          "cn.example"
        ],
        "server": "udp"
      },
      {
        "domain_keyword": [
          "tracker"
        ],
        "action": "reject"
      },
      {
        "domain": [
          "fixed.example"
        ],
        "action": "predefined",
        "rcode": "NOERROR",
        "answer": [
          "fixed.example. IN A 192.0.2.10"
        ]
      }
    ],
    "final": "https",
    "strategy": "prefer_ipv4"
  },
  "outbounds": [
    {
      "type": "trojan",
      "tag": "proxy",
      "server": "s1.example.net",
      "server_port": 443,
      "password": "p1",
      "tls": {
        "enabled": true,
        "server_name": "server.example.com"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "proxy",
    "default_domain_resolver": "local"
  }
}
