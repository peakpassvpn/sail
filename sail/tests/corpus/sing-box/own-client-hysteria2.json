{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2",
      "server": "s1.example.net",
      "server_port": 443,
      "up_mbps": 50,
      "down_mbps": 200,
      "obfs": {
        "type": "salamander",
        "password": "a synthetic obfs password"
      },
      "password": "a synthetic password",
      "tls": {
        "enabled": true,
        "server_name": "server.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "hy2"
  }
}
