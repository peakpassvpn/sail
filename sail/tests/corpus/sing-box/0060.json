{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "type": "https",
        "server": "192.0.2.1",
        "detour": "Proxy 1"
      },
      {
        "tag": "dns-2",
        "type": "https",
        "server": "192.0.2.2",
        "detour": "Proxy 1"
      },
      {
        "tag": "dns-3",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "set-2"
        ],
        "server": "dns-1",
        "rule_set_ip_cidr_accept_empty": true
      },
      {
        "rule_set": [
          "set-3"
        ],
        "server": "dns-3",
        "rule_set_ip_cidr_accept_empty": true
      }
    ],
    "final": "dns-2"
  },
  "inbounds": [
    {
      "type": "anytls",
      "tag": "in-1",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "name": "user1",
          "password": "00005a11-0000-4000-8000-000000000001"
        }
      ],
      "padding_scheme": [
        "str1",
        "str2",
        "str3",
        "str4",
        "str5",
        "str6",
        "str7",
        "str8",
        "str9"
      ],
      "tls": {
        "enabled": true,
        "server_name": "sni1.example.org",
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "min_version": "1.2",
        "max_version": "1.3",
        "cipher_suites": [
          "wywOQgzCr2vr85JpoMxzCQ",
          "WulOoXrJ4xaeREDpCXJqPA",
          "uLBP4fDmzzQr6AI9Cjs2bG1yyu2a"
        ],
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "sni1.example.org",
            "server_port": 443
          },
          "private_key": "C7R4HcnA7nosUls057QlZXh18tDK3yhe4-6I1jkpNJM",
          "short_id": [
            "704c7085dd7b3f73"
          ],
          "max_time_difference": "1m"
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Proxy 1",
      "domain_resolver": {
        "server": "dns-1",
        "rewrite_ttl": 60
      }
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "set-3"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "set-1",
          "set-2"
        ],
        "action": "route",
        "outbound": "Proxy 1"
      }
    ],
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p1.srs",
        "download_detour": "Proxy 1",
        "update_interval": "24h"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p2.srs",
        "download_detour": "Proxy 1",
        "update_interval": "24h"
      },
      {
        "tag": "set-3",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p3.srs",
        "download_detour": "Proxy 1",
        "update_interval": "24h"
      }
    ],
    "auto_detect_interface": true,
    "final": "Proxy 1",
    "default_domain_resolver": {
      "server": "dns-2",
      "rewrite_ttl": 60
