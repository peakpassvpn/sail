{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "type": "udp",
        "server": "192.0.2.1"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA"
        ],
        "action": "reject"
      }
    ],
    "final": "dns-1"
  },
  "http_clients": [
    {
      "tag": "str4",
      "detour": "Proxy 2"
    }
  ],
  "inbounds": [
    {
      "type": "vless",
      "tag": "in-1",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "uuid": "00005a11-0000-4000-8000-000000000001",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "sni1.example.org",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "sni1.example.org",
            "server_port": 443
          },
          "private_key": "password1",
          "short_id": [
            "str1"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "Proxy 1",
      "server": "str2",
      "server_port": "str3",
      "username": "user1",
      "password": "password2"
    },
    {
      "type": "direct",
      "tag": "Proxy 2"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-1",
    "default_http_client": "str4",
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p1.srs",
        "http_client": "str4"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p2.srs",
        "http_client": "str4"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "set-2"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "d2.example",
          "d3.example"
        ],
        "outbound": "Proxy 2"
      },
      {
        "rule_set": [
          "set-1"
        ],
        "outbound": "Proxy 2"
      }
    ],
    "final": "Proxy 1"
  }
}
