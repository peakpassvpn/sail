{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "address": "https://192.0.2.1/dns-query",
        "address_resolver": "dns-2",
        "strategy": "prefer_ipv4"
      },
      {
        "tag": "dns-2",
        "address": "https://192.0.2.2/dns-query",
        "detour": "Proxy 2"
      },
      {
        "tag": "dns-3",
        "address": "fakeip"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "dns-2"
      },
      {
        "rule_set": [
          "set-4",
          "set-5",
          "set-6",
          "set-7",
          "set-8"
        ],
        "server": "dns-3",
        "rewrite_ttl": 1
      }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/16"
    },
    "independent_cache": true,
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "in-1",
      "address": [
        "192.0.2.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "sniff": true,
      "sniff_override_destination": true,
      "domain_strategy": "prefer_ipv4"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Group 1",
      "outbounds": [
        "Group 2",
        "Proxy 1",
        "Proxy 2"
      ],
      "default": "Group 2"
    },
    {
      "type": "urltest",
      "tag": "Group 2",
      "outbounds": [
        "Proxy 1"
      ],
      "url": "https://h1.example.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "Proxy 1",
      "server": "s1.example.net",
      "server_port": 443,
      "uuid": "00005a11-0000-4000-8000-000000000001",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "sni2.example.org",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "wywOQgzCr2vr85JpoMxzCakHIIvgUtsG6_Qp987NJa4",
          "short_id": "704c"
        }
      }
    },
    {
      "type": "direct",
      "tag": "Proxy 2"
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p1.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p2.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-3",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p3.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-4",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p4.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-5",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p5.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-6",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p6.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-7",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p7.json",
        "update_interval": "24h"
      },
      {
        "tag": "set-8",
        "type": "remote",
        "format": "source",
        "url": "https://h2.example.com/p8.json",
        "update_interval": "24h"
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "Proxy 2"
      },
      {
        "rule_set": [
          "set-1",
          "set-2",
          "set-3"
        ],
        "outbound": "Proxy 2"
      },
      {
        "rule_set": [
          "set-4",
          "set-5",
          "set-6",
          "set-7",
          "set-8"
        ],
        "outbound": "Group 1"
      },
      {
        "geoip": [
          "ru"
        ],
        "outbound": "Proxy 2"
      }
    ],
    "final": "Proxy 2",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    }
  }
}
