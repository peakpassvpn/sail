{
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "type": "https",
        "server": "s1.example.net",
        "domain_resolver": "dns-4",
        "detour": "Group 1"
      },
      {
        "tag": "dns-2",
        "type": "https",
        "server": "192.0.2.1"
      },
      {
        "tag": "dns-3",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "3f00::/18"
      },
      {
        "tag": "dns-4",
        "type": "hosts",
        "predefined": {
          "s1.example.net": [
            "192.0.2.2",
            "192.0.2.3"
          ]
        }
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "dns-2"
      },
      {
        "clash_mode": "Global",
        "server": "dns-1"
      },
      {
        "query_type": "HTTPS",
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "set-9",
        "server": "dns-3"
      },
      {
        "rule_set": "set-9",
        "server": "dns-2"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "set-7",
            "invert": true
          },
          {
            "rule_set": "set-8"
          }
        ],
        "server": "dns-1",
        "client_subnet": "192.0.2.114/24"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-3"
      }
    ],
    "final": "dns-1",
    "independent_cache": true,
    "strategy": "prefer_ipv4"
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": "set-2",
        "action": "reject"
      },
      {
        "protocol": [
          "bittorrent",
          "ssh"
        ],
        "outbound": "Proxy 1"
      },
      {
        "ip_is_private": true,
        "outbound": "Proxy 1"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Proxy 1"
      },
      {
        "clash_mode": "Global",
        "outbound": "Group 1"
      },
      {
        "rule_set": [
          "set-1",
          "set-4",
          "set-5",
          "set-6",
          "set-3"
        ],
        "outbound": "Proxy 1"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "set-7"
          },
          {
            "invert": true,
            "rule_set": [
              "set-9"
            ]
          }
        ],
        "outbound": "Group 1"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "set-9",
          "set-8"
        ],
        "outbound": "Proxy 1"
      }
    ],
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "source",
        "url": "https://h1.example.com/p1.json",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "source",
        "url": "https://h1.example.com/p2.json",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-3",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p3.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-4",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p4.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-5",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p5.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-6",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p6.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-7",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p7.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-8",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p8.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-9",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p9.srs",
        "download_detour": "Proxy 1"
      }
    ],
    "default_domain_resolver": "dns-2",
    "auto_detect_interface": true,
    "final": "Group 1"
  },
  "outbounds": [
    {
      "tag": "Proxy 1",
      "type": "direct"
    },
    {
      "tag": "Group 1",
      "type": "selector"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "192.0.2.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "stack": "system",
      "auto_route": true,
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "listen": "::",
      "listen_port": 7890
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "./path-1",
      "external_ui_download_url": "https://h2.example.com/p10.zip",
      "external_ui_download_detour": "Proxy 1",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_rdrc": true
    }
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
