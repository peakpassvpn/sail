{
  "dns": {
    "servers": [
      {
        "tag": "dns-1",
        "address": "192.0.2.1",
        "detour": "Proxy 1"
      },
      {
        "tag": "dns-2",
        "address": "192.0.2.2",
        "detour": "Proxy 1"
      },
      {
        "tag": "dns-3",
        "address": "192.0.2.3",
        "detour": "Proxy 1"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "set-2"
        ],
        "domain_suffix": [
          "d1.example",
          "d2.example"
        ],
        "server": "dns-3"
      }
    ],
    "strategy": "ipv4_only"
  },
  "outbounds": [
    {
      "tag": "Proxy 1",
      "type": "direct",
      "domain_strategy": "ipv4_only"
    },
    {
      "type": "block",
      "tag": "Proxy 2"
    },
    {
      "tag": "Proxy 3",
      "type": "socks",
      "server": "127.0.0.1",
      "server_port": 40000
    },
    {
      "type": "direct",
      "tag": "Proxy 4",
      "domain_strategy": "prefer_ipv6",
      "bind_interface": "if1"
    },
    {
      "tag": "Proxy 5",
      "type": "direct",
      "domain_strategy": "ipv4_only"
    },
    {
      "tag": "Proxy 6",
      "type": "direct",
      "domain_strategy": "ipv6_only"
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "set-1",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p1.srs",
        "download_detour": "Proxy 1"
      },
      {
        "tag": "set-2",
        "type": "remote",
        "format": "binary",
        "url": "https://h1.example.com/p2.srs",
        "download_detour": "Proxy 1"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "set-1"
        ],
        "outbound": "Proxy 1"
      },
      {
        "rule_set": [
          "set-2"
        ],
        "domain": [
          "d1.example",
          "d2.example"
        ],
        "outbound": "Proxy 1"
      },
      {
        "ip_is_private": true,
        "outbound": "Proxy 2"
      },
      {
        "domain_regex": [
          "^d1\\.example$",
          "^d2\\.example$",
          "^d3\\.example$",
          "^d4\\.example$",
          "^d5\\.example$",
          "^d6\\.example$",
          "^d7\\.example$",
          "^d8\\.example$",
          "^d9\\.example$",
          "^d10\\.example$",
          "^d11\\.example$",
          "^d12\\.example$"
        ],
        "outbound": "Proxy 2"
      },
      {
        "domain_suffix": [
          "d3.example",
          "d4.example",
          "d5.example",
          "d6.example",
          "d7.example",
          "d8.example",
          "d9.example",
          "d10.example",
          "d11.example",
          "d12.example",
          "d13.example",
          "d14.example",
          "d15.example",
          "d16.example",
          "d17.example"
        ],
        "outbound": "Proxy 2"
      },
      {
        "protocol": [
          "bittorrent"
        ],
        "outbound": "Proxy 2"
      },
      {
        "port": [
          22,
          25,
          26,
          3306,
          465,
          587,
          993,
          995,
          110,
          7
        ],
        "outbound": "Proxy 2"
      },
      {
        "outbound": "Proxy 1",
        "network": [
          "udp",
          "tcp"
        ]
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
