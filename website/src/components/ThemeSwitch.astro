<starlight-theme-switcher>
  <div class="theme-switcher" role="group" aria-label="Select color theme">
    <button type="button" data-theme-choice="light" aria-label="Use light theme" title="Light">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2.2M12 19.8V22M4.93 4.93l1.56 1.56M17.51 17.51l1.56 1.56M2 12h2.2M19.8 12H22M4.93 19.07l1.56-1.56M17.51 6.49l1.56-1.56"></path>
      </svg>
    </button>
    <button type="button" data-theme-choice="dark" aria-label="Use dark theme" title="Dark">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.2 15.1A8.4 8.4 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
      </svg>
    </button>
    <button type="button" data-theme-choice="auto" aria-label="Follow system theme" title="System">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4.5" width="18" height="13" rx="2"></rect>
        <path d="M8 21h8M12 17.5V21"></path>
      </svg>
    </button>
  </div>
</starlight-theme-switcher>

<script>
  type ThemeChoice = 'light' | 'dark' | 'auto';

  const storageKey = 'starlight-theme';
  const preferredTheme = () => matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  const savedTheme = (): ThemeChoice => {
    const value = localStorage.getItem(storageKey);
    return value === 'light' || value === 'dark' ? value : 'auto';
  };

  class SailThemeSwitcher extends HTMLElement {
    #choice: ThemeChoice = savedTheme();
    #media = matchMedia('(prefers-color-scheme: light)');

    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((button) => {
        button.addEventListener('click', () => this.#apply(button.dataset.themeChoice as ThemeChoice));
      });
      this.#media.addEventListener('change', this.#handleSystemChange);
      this.#apply(this.#choice);
    }

    disconnectedCallback() {
      this.#media.removeEventListener('change', this.#handleSystemChange);
    }

    #handleSystemChange = () => {
      if (this.#choice === 'auto') this.#apply('auto');
    };

    #apply(choice: ThemeChoice) {
      this.#choice = choice;
      document.documentElement.dataset.theme = choice === 'auto' ? preferredTheme() : choice;
      localStorage.setItem(storageKey, choice === 'auto' ? '' : choice);
      this.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((button) => {
        const active = button.dataset.themeChoice === choice;
        button.toggleAttribute('data-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }
  }

  if (!customElements.get('starlight-theme-switcher')) {
    customElements.define('starlight-theme-switcher', SailThemeSwitcher);
  }
</script>

<style>
  .theme-switcher {
    display: grid;
    grid-template-columns: repeat(3, 2rem);
    gap: .2rem;
    padding: .25rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: .8rem;
    background: color-mix(in srgb, var(--sl-color-bg) 88%, var(--sl-color-bg-nav));
    box-shadow: 0 6px 22px rgb(8 31 73 / 6%);
  }

  button {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: .55rem;
    color: var(--sl-color-gray-3);
    background: transparent;
    cursor: pointer;
    transition: color 140ms ease, background-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  button:hover {
    color: var(--sl-color-white);
    transform: translateY(-1px);
  }

  button[data-active] {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-bg-accent);
    box-shadow: 0 5px 14px rgb(7 92 255 / 20%);
  }

  button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
