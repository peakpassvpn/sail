[Unit]
Description=Sail proxy service
Documentation=https://github.com/eycorsican/leaf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sail
Group=sail
EnvironmentFile=/etc/sail/sail.env
ExecStartPre=@SAIL_BINARY@ --config ${SAIL_CONFIG} --data-dir ${SAIL_DATA_DIR} --cache-dir ${SAIL_CACHE_DIR} --profile ${SAIL_PROFILE} --test
ExecStart=@SAIL_BINARY@ --config ${SAIL_CONFIG} --data-dir ${SAIL_DATA_DIR} --cache-dir ${SAIL_CACHE_DIR} --profile ${SAIL_PROFILE}
KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=on-failure
RestartSec=2s

# Filesystem and privilege isolation for an ordinary local proxy.
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CacheDirectory=sail
CacheDirectoryMode=0750

[Install]
WantedBy=multi-user.target
