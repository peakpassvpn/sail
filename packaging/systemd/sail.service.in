[Unit]
Description=Sail proxy service
Documentation=https://github.com/peakpassvpn/sail
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sail
Group=sail
EnvironmentFile=/etc/sail/sail.env
ExecStartPre=@SAIL_BINARY@ --config ${SAIL_CONFIG} --data-dir ${SAIL_DATA_DIR} --cache-dir ${SAIL_CACHE_DIR} --profile ${SAIL_PROFILE} --test
ExecStart=@SAIL_BINARY@ --config ${SAIL_CONFIG} --data-dir ${SAIL_DATA_DIR} --cache-dir ${SAIL_CACHE_DIR} --profile ${SAIL_PROFILE}
# A reload is checked before it is sent: a configuration that fails the
# check fails `systemctl reload`, and one that fails in the process leaves
# the configuration before running. A reload takes DNS, outbounds, routing
# and the inbounds: added, removed and changed ones are applied, and the
# connections of one removed or replaced are closed. One that adds, removes
# or changes a TUN inbound is refused in the process with an error in the
# journal, while `systemctl reload` still succeeds: that needs
# `systemctl restart`.
ExecReload=@SAIL_BINARY@ --config ${SAIL_CONFIG} --data-dir ${SAIL_DATA_DIR} --cache-dir ${SAIL_CACHE_DIR} --profile ${SAIL_PROFILE} --test
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM stops taking connections and lets those open finish, 30 s at
# most with the server profile (lifecycle.drain_timeout); past this bound
# systemd kills the process.
KillSignal=SIGTERM
TimeoutStopSec=45s
Restart=on-failure
RestartSec=2s

# Filesystem and privilege isolation for an ordinary local proxy.
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CacheDirectory=sail
CacheDirectoryMode=0750

[Install]
WantedBy=multi-user.target
